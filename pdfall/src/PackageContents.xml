<?xml version="1.0" encoding="utf-8"?>
<!-- AutoCAD loads PDFALL.bundle from %APPDATA%\Autodesk\ApplicationPlugins into every drawing.
     Keep AppVersion equal to *pdfall-version* in src\lsp\00-settings.lsp. -->
<ApplicationPackage SchemaVersion="1.0" AutodeskProduct="AutoCAD" ProductType="Application"
                    Name="PDFALL" AppVersion="1.9.0"
                    Description="Plots every лист, специфікація and текстовий документ in Model space to PDF and merges them."
                    ProductCode="{7B1B8584-E07A-4DFE-B3C7-90CADBF6934E}"
                    UpgradeCode="{2D5B5A1F-3249-4158-8168-F061F321423A}">
  <Components Description="PDFALL">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.0" SupportPath="./Contents" />
    <ComponentEntry AppName="PDFALL" ModuleName="./Contents/pdfall.lsp"
                    AppDescription="PDFALL, PDFNUM, PDFLIST, PDFSPEC, PDFSETTINGS and PDFDEBUG commands" LoadOnAutoCADStartup="True" PerDocument="True">
      <Commands GroupName="PDFALL">
        <Command Local="PDFALL" Global="PDFALL" />
        <Command Local="PDFNUM" Global="PDFNUM" />
        <Command Local="PDFLIST" Global="PDFLIST" />
        <Command Local="PDFSPEC" Global="PDFSPEC" />
        <Command Local="PDFSETTINGS" Global="PDFSETTINGS" />
        <Command Local="PDFDEBUG" Global="PDFDEBUG" />
      </Commands>
    </ComponentEntry>
    <!-- The PDFALL ribbon tab, built by src\ribbon.ps1. -->
    <ComponentEntry AppName="PDFALL_Ribbon" ModuleName="./Contents/PDFALL.cuix"
                    AppDescription="PDFALL ribbon tab" LoadOnAutoCADStartup="True" />
  </Components>
</ApplicationPackage>
